class Person:
    def __init__(self, fio: str):
        self._fio = fio

    def set_fio(self, fio: str):
        self._fio = fio

    def get_fio(self) -> str:
        return self._fio

    def print_info(self):
        print(f"ФИО: {self._fio}")

    def get_type(self) -> str:
        return "Person"


class Student(Person):
    def __init__(self, fio: str, course: int, group: int):
        super().__init__(fio)
        self._course = course
        self._group = group

    def set_course(self, course: int):
        self._course = course

    def get_course(self) -> int:
        return self._course

    def set_group(self, group: int):
        self._group = group

    def get_group(self) -> int:
        return self._group

    def print_info(self):
        print(f"студент ФИО: {self.get_fio()}, курс: {self._course}, группа: {self._group}")

    def get_type(self) -> str:
        return "Student"


class Professor(Person):
    def __init__(self, fio: str, department: str):
        super().__init__(fio)
        self._department = department

    def set_department(self, department: str):
        self._department = department

    def get_department(self) -> str:
        return self._department

    def print_info(self):
        print(f"преподаватель ФИО: {self.get_fio()}, кафедра: {self._department}")

    def get_type(self) -> str:
        return "Professor"


def main():
    sostav_univera = []

    while True:
        print("\nМЕНЮ")
        print("1. ввести студента")
        print("2. ввести преподавателя")
        print("3. вывести студентов")
        print("4. вывести преподавателей")
        print("5. конец")
        
        choice = input("выберите пункт: ")

        if choice == "5":
            break

        if choice == "1":
            fio = input("введите ФИО студента: ")
            course = int(input("введите курс: "))
            group = int(input("введите группу: "))
            sostav_univera.append(Student(fio, course, group))
        elif choice == "2":
            fio = input("введите ФИО преподавателя: ")
            department = input("введите кафедру: ")
            sostav_univera.append(Professor(fio, department))
        elif choice == "3":
            print("\nсписок студентов")
            for obj in sostav_univera:
                if obj.get_type() == "Student":
                    obj.print_info()
        elif choice == "4":
            print("\nсписок преподавателей")
            for obj in sostav_univera:
                if obj.get_type() == "Professor":
                    obj.print_info()
        else:
            print("нет такого пункта")

main()
