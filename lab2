    print(f"все цифры {n} различны: {check_digits_unique(n)}")
    print(f"без цифр, кратных мин: {remove_kratnoe_min_digit(n)}")
    
    if n > 0:
        primes = get_primes(n)
        if primes:
            print(f"простые до {n}: {(primes)}")
        else:
            print("простых нет")

    a = int(input("введите натур a: "))
